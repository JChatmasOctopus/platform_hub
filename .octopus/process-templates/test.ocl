name = "Test"
description = ""

icon {
    color = "#D63D3D"
    id = "fire-alt"
}

parameter "compliance-account" {
    display_settings = {
        Octopus.ControlType = "UsernamePasswordAccount"
    }
    help_text = ""
    label = "Account Param"

    value "vault-credentials" {}
}

parameter "tmp.workerpool" {
    display_settings = {
        Octopus.ControlType = "WorkerPool"
    }
    help_text = ""
    label = "Worker pool"
}

parameter "test.account" {
    display_settings = {
        Octopus.ControlType = "UsernamePasswordAccount"
    }
    help_text = ""
    label = "Test account"

    value "vault-credentials" {}
}

parameter "compliance.check.account" {
    display_settings = {
        Octopus.ControlType = "UsernamePasswordAccount"
    }
    help_text = ""
    label = "Compliance check account"

    value "vault-credentials" {}
}

parameter "test.param" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = ""
    label = ""

    value "TheResult" {}
}

parameter "template.account" {
    display_settings = {
        Octopus.ControlType = "UsernamePasswordAccount"
    }
    help_text = ""
    label = ""

    value "vault-credentials" {}
}

step "run-a-script" {
    name = "Run a Script"

    action {
        action_type = "Octopus.Script"
        properties = {
            Octopus.Action.RunOnServer = "true"
            Octopus.Action.Script.ScriptBody = <<-EOT
                usern=$(get_octopusvariable "ProcessTemplates[Test].compliance-account.Username")
                passwo=$(get_octopusvariable "ProcessTemplates[Test].compliance-account.Password")
                echo "User name: $usern"
                echo "Password: $passwo"
                echo "Direct: #{ProcessTemplates[Test].compliance-account.Username}"
                echo "============================================"
                echo "Process Template Account Parameter Test"
                echo "Template: Test"
                echo "============================================"
                
                echo ""
                echo "--- 1. compliance-account (hyphenated) ---"
                echo ""
                echo "[Octostache] Username: #{ProcessTemplates[Test].compliance-account.Username}"
                echo "[Octostache] Password: #{ProcessTemplates[Test].compliance-account.Password}"
                echo "[get_octopusvariable] Username: $(get_octopusvariable "ProcessTemplates[Test].compliance-account.Username")"
                echo "[get_octopusvariable] Password: $(get_octopusvariable "ProcessTemplates[Test].compliance-account.Password")"
                
                echo ""
                echo "--- 2. test.account (single dot) ---"
                echo ""
                echo "[Octostache] Username: #{ProcessTemplates[Test].test.account.Username}"
                echo "[Octostache] Password: #{ProcessTemplates[Test].test.account.Password}"
                echo "[get_octopusvariable] Username: $(get_octopusvariable "ProcessTemplates[Test].test.account.Username")"
                echo "[get_octopusvariable] Password: $(get_octopusvariable "ProcessTemplates[Test].test.account.Password")"
                
                echo ""
                echo "--- 3. compliance.check.account (multi-dot) ---"
                echo ""
                echo "[Octostache] Username: #{ProcessTemplates[Test].compliance.check.account.Username}"
                echo "[Octostache] Password: #{ProcessTemplates[Test].compliance.check.account.Password}"
                echo "[get_octopusvariable] Username: $(get_octopusvariable "ProcessTemplates[Test].compliance.check.account.Username")"
                echo "[get_octopusvariable] Password: $(get_octopusvariable "ProcessTemplates[Test].compliance.check.account.Password")"
                
                echo ""
                echo "--- 4. test.param (single-line text, NOT an account) ---"
                echo ""
                echo "[Octostache] Value: #{ProcessTemplates[Test].test.param}"
                echo "[get_octopusvariable] Value: $(get_octopusvariable "ProcessTemplates[Test].test.param")"
                
                echo ""
                echo "--- Raw account references (no .Username/.Password) ---"
                echo ""
                echo "[get_octopusvariable] compliance-account: $(get_octopusvariable "ProcessTemplates[Test].compliance-account")"
                echo "[get_octopusvariable] test.account: $(get_octopusvariable "ProcessTemplates[Test].test.account")"
                echo "[get_octopusvariable] compliance.check.account: $(get_octopusvariable "ProcessTemplates[Test].compliance.check.account")"
                echo "[get_octopusvariable] test.param: $(get_octopusvariable "ProcessTemplates[Test].test.param")"
                
                echo ""
                echo "--- Without ProcessTemplates prefix (control) ---"
                echo ""
                echo "[Octostache] compliance-account.Username: #{compliance-account.Username}"
                echo "[Octostache] test.account.Username: #{test.account.Username}"
                echo "[Octostache] compliance.check.account.Username: #{compliance.check.account.Username}"
                echo "[Octostache] test.param: #{test.param}"
                
                echo ""
                echo "============================================"
                echo "Test complete"
                echo "============================================"
                EOT
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "Bash"
            OctopusUseBundledTooling = "False"
        }
        worker_pool_variable = "#{tmp.workerpool}"
    }
}

step "run-a-script2" {
    name = "Run a Script2"

    action {
        action_type = "Octopus.Script"
        properties = {
            Octopus.Action.RunOnServer = "true"
            Octopus.Action.Script.ScriptBody = <<-EOT
                usern=$(get_octopusvariable "ProcessTemplates[test].template.account.Username")
                passwo=$(get_octopusvariable "ProcessTemplates[test].template.account.Password")
                echo "User name: $usern"
                echo "Password: $passwo"
                
                echo "Direct: #{ProcessTemplates[test].template.account.Username}"
                
                echo "-------------"
                
                usern=$(get_octopusvariable "ProcessTemplates[Test].template.account.Username")
                passwo=$(get_octopusvariable "ProcessTemplates[Test].template.account.Password")
                echo "User name: $usern"
                echo "Password: $passwo"
                
                echo "Direct: #{ProcessTemplates[Test].template.account.Username}"
                EOT
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "PowerShell"
            OctopusUseBundledTooling = "False"
        }
        worker_pool_variable = "#{tmp.workerpool}"
    }
}